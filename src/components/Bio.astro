---
// Bio component for author information
// Converted from the old Gatsby bio.js component
---

<div class="bio-container">
  <img src="/profile-pic.png" alt="Nicolas Carlo" class="bio-avatar" />
  <p class="bio-text">
    Written by{" "}
    <a href="https://twitter.com/nicoespeon">
      <strong>Nicolas Carlo</strong>
    </a>{" "}
    who lives and works in Montreal, Canada 🍁
    <br />
    He founded the{" "}
    <a href="https://www.meetup.com/fr-FR/Software-Crafters-Montreal"> Software Crafters Montreal </a>{" "}
    community which cares about building maintainable softwares.
  </p>
</div>

<style>
  .bio-container {
    display: flex;
    align-items: center;
    margin-bottom: 1.75rem;
  }

  .bio-avatar {
    margin-right: 0.75rem;
    margin-bottom: 0;
    border-radius: 50%;
    width: 50px;
    min-width: 50px;
    height: 50px;
  }

  .bio-text {
    margin-bottom: 0;
  }
</style>
