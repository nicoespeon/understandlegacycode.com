<style lang="scss" is:global>
  body {
    // #ed1b2e
    --primary: hsla(354.6, 85.4%, 51.8%, 1);
    --dark: hsla(354.6, 70%, 20%, 1);
    --background: hsla(354.6, 85.4%, 51.8%, 0.3);
